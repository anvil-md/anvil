{
  "name": "anvil-md",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "check": "bun run typecheck && bun test && bun run lint && bun run test:swift",
    "test:swift": "swift test --quiet",
    "lint": "bun packages/lint/src/cli.ts SPEC.md README.md",
    "conformance": "bun test packages/conformance",
    "spec": "bun run scripts/split-spec.ts",
    "site:dev": "cd site && bun run dev",
    "site:build": "cd site && bun run build"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.7.0"
  }
}
