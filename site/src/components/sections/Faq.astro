---
import SectionShell from '@/components/SectionShell.astro'
import { md } from '@/lib/md'
import type { Section } from '@/types'

interface Props {
	section: Extract<Section, { kind: 'faq' }>
}

const { section } = Astro.props
---

<SectionShell id={section.id} title={section.title} lead={section.lead} width="prose">
	<div class="op-faq divide-y divide-line border-y border-line">
		{
			section.items.map(item => (
				<details class="op-faqrow group">
					{/* justify-start + ml-auto, NOT justify-between: presets that add a
					    ::before to .op-h2 introduce a third flex item, and space-between
					    then strands the question text in the middle of the row.

					    op-faqq is its own hook on top of op-h2. A question is a list row,
					    not a section title, and a preset that restyles .op-h2 - size,
					    display, a highlighter behind it - was dragging every question up
					    to heading scale with it. */}
					<summary class="op-faqq op-h2 flex cursor-pointer list-none items-center justify-start gap-3 py-5 text-base transition-colors hover:text-accent">
						{item.q}
						<span class="op-faqmark op-body ml-auto pl-6 text-muted transition-transform duration-300 group-open:rotate-45">
							+
						</span>
					</summary>
					<p class="op-body pb-6 leading-relaxed text-muted text-pretty" set:html={md(item.a)} />
				</details>
			))
		}
	</div>
</SectionShell>
