---
import SectionShell from '@/components/SectionShell.astro'
import { md } from '@/lib/md'
import type { Section } from '@/types'

interface Props {
	section: Extract<Section, { kind: 'steps' }>
}

const { section } = Astro.props
---

<SectionShell id={section.id} title={section.title} lead={section.lead}>
	<ol class="op-steps relative border-l border-line pl-8">
		{
			section.items.map((item, index) => (
				<li class="pb-12 last:pb-0">
					<span class="op-step-marker absolute -left-[13px] flex h-6 w-6 items-center justify-center rounded-full bg-accent font-mono text-[11px] font-semibold text-accent-fg">
						{index + 1}
					</span>
					<h3 class="op-h2 text-lg">{item.title}</h3>
					<p
						class="op-body mt-2 max-w-2xl leading-relaxed text-muted text-pretty"
						set:html={md(item.body)}
					/>
				</li>
			))
		}
	</ol>
</SectionShell>
