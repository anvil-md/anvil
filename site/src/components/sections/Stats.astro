---
import SectionShell from '@/components/SectionShell.astro'
import type { Section } from '@/types'

interface Props {
	section: Extract<Section, { kind: 'stats' }>
}

const { section } = Astro.props
---

<SectionShell id={section.id} title={section.title} lead={section.lead}>
	<!-- op-statgrid, NOT op-cardgrid: stat figures paint no background of their
	     own, so a preset's gap-as-rules fill must never become their backdrop. -->
	<dl class="op-statgrid grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
		{
			section.items.map(item => (
				<div class="op-statitem">
					<dt class="op-stat text-4xl text-accent tabular-nums sm:text-5xl">{item.value}</dt>
					<dd class="op-body mt-2 text-sm leading-relaxed text-muted">{item.label}</dd>
				</div>
			))
		}
	</dl>
</SectionShell>
