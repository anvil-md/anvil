---
import SectionShell from '@/components/SectionShell.astro'
import { md } from '@/lib/md'
import { resolveTheme } from '@/lib/theme'
import type { Page, Section } from '@/types'

interface Props {
	section: Extract<Section, { kind: 'features' }>
	theme: Page['theme']
}

const { section, theme } = Astro.props
const { layout } = resolveTheme(theme).preset

const cols = {
	2: 'sm:grid-cols-2',
	3: 'sm:grid-cols-2 lg:grid-cols-3',
	4: 'sm:grid-cols-2 lg:grid-cols-4',
}[section.columns ?? 3]
---

<SectionShell id={section.id} title={section.title} lead={section.lead}>
	{
		layout.features === 'grid' && (
			<div class:list={['op-cardgrid grid gap-px overflow-hidden bg-line', cols]}>
				{section.items.map(item => (
					<article
						class="op-card bg-bg p-7 transition-colors duration-300"
					>
						{item.icon && (
							<div class="op-icon mb-5 flex h-10 w-10 items-center justify-center border border-line text-lg">
								{item.icon}
							</div>
						)}
						<h3 class="op-card-title op-h2 text-base">{item.title}</h3>
						<p
							class="op-body mt-2 leading-relaxed text-muted text-pretty"
							set:html={md(item.body)}
						/>
					</article>
				))}
			</div>
		)
	}

	{/* rows: full-bleed bars. Icon and title hold a fixed left column, body runs
	    long on the right. Reads as a manifest rather than a card wall. */}
	{
		layout.features === 'rows' && (
			<div class="op-rows">
				{section.items.map(item => (
					<article
						class="op-row grid gap-x-8 gap-y-2 border-t border-line py-8 sm:grid-cols-[minmax(0,18rem)_1fr] sm:items-baseline"
					>
						<h3 class="op-card-title op-h2 flex items-baseline gap-3 text-xl">
							{item.icon && <span class="op-icon-inline opacity-70">{item.icon}</span>}
							{item.title}
						</h3>
						<p
							class="op-body text-lg leading-relaxed text-muted text-pretty"
							set:html={md(item.body)}
						/>
					</article>
				))}
			</div>
		)
	}

	{/* index: a numbered hairline list, set like a table of contents. */}
	{
		layout.features === 'index' && (
			<ol class="op-index">
				{section.items.map((item, index) => (
					<li
						class="op-indexrow grid grid-cols-[2.5rem_1fr] gap-x-5 border-b border-line py-6 sm:grid-cols-[3rem_minmax(0,14rem)_1fr] sm:gap-x-8"
					>
						<span class="op-indexnum op-eyebrow pt-1 text-sm tabular-nums opacity-60">
							{String(index + 1).padStart(2, '0')}
						</span>
						<h3 class="op-card-title op-h2 text-lg">{item.title}</h3>
						<p
							class="op-body col-span-2 leading-relaxed text-muted text-pretty sm:col-span-1"
							set:html={md(item.body)}
						/>
					</li>
				))}
			</ol>
		)
	}
</SectionShell>
