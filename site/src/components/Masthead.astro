---
// The document header - a standards masthead, not a product nav.
const nav = [
	{ label: 'Overview', href: '/' },
	{ label: 'Specification', href: '/spec/' },
	{ label: 'Playground', href: '/playground/' },
	{ label: 'Repository', href: 'https://github.com/anvil-md/anvil' },
]
---

<header class="sticky top-0 z-40 border-b border-rule bg-paper/85 backdrop-blur-sm">
	<!-- Status strip: this is a document, and it declares its state. -->
	<div class="border-b border-rule/70 bg-paper-sunk/60">
		<div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-5 py-1.5 lg:px-6">
			<span class="clause-label">Specification &middot; v1 Working Draft</span>
			<span class="clause-label hidden sm:inline">MIT &middot; 2026</span>
		</div>
	</div>

	<div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-5 py-3 lg:px-6">
		<a href="/" class="group flex items-baseline gap-2.5">
			<span class="inline-block h-3 w-3 shrink-0 translate-y-px bg-accent"></span>
			<span class="font-mono text-sm font-semibold tracking-tight text-ink">
				anvil<span class="text-ink-faint">&middot;</span>md
			</span>
		</a>

		<nav class="hidden items-center gap-6 md:flex">
			{
				nav.map((n) => (
					<a
						href={n.href}
						class="font-mono text-xs tracking-wide text-ink-soft transition-colors hover:text-accent-ink"
					>
						{n.label}
					</a>
				))
			}
		</nav>

		<div class="flex items-center gap-2">
			<button
				id="theme-toggle"
				type="button"
				aria-label="Toggle theme"
				class="grid h-8 w-8 place-items-center border border-rule text-ink-soft transition-colors hover:border-accent hover:text-accent-ink"
			>
				<span class="font-mono text-xs">&#9680;</span>
			</button>
		</div>
	</div>
</header>

<script is:inline>
	document.getElementById('theme-toggle')?.addEventListener('click', () => {
		const el = document.documentElement
		const dark = !el.classList.contains('dark')
		el.classList.toggle('dark', dark)
		localStorage.setItem('anvil-theme', dark ? 'dark' : 'light')
	})
</script>
