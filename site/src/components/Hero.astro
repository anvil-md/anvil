---
import Button from '@/components/Button.astro'
import { md } from '@/lib/md'
import { resolveTheme } from '@/lib/theme'
import type { Page } from '@/types'

interface Props {
	hero: Page['hero']
	theme: Page['theme']
}

const { hero, theme } = Astro.props
const { layout } = resolveTheme(theme).preset

// Four genuinely different silhouettes, not four paddings. `banner` puts the
// whole hero on an accent slab; `split` sets title and lead as two columns;
// `centred` stacks on the axis; `left` is the plain flush-left column.
const pad = {
	tight: 'pt-32 pb-20 sm:pt-40 sm:pb-24',
	normal: 'pt-40 pb-28 sm:pt-52 sm:pb-36',
	airy: 'pt-48 pb-36 sm:pt-64 sm:pb-52',
}[layout.density]

const banner = layout.hero === 'banner'
const centred = layout.hero === 'centred'
const split = layout.hero === 'split'
---

<section
	id="top"
	class:list={[
		'op-hero relative overflow-hidden px-6',
		pad,
		banner && 'op-hero-banner bg-accent text-accent-fg',
		centred && 'op-hero-centred text-center',
		split && 'op-hero-split',
	]}
>
	{
		!banner && (
			<div
				class="op-glow pointer-events-none absolute -top-1/3 left-1/2 -z-10 h-[52rem] w-[52rem] -translate-x-1/2 rounded-full bg-accent opacity-[0.13] blur-[140px]"
				aria-hidden="true"
			/>
		)
	}

	<div
		class:list={[
			'op-measure mx-auto w-full',
			centred ? 'max-w-3xl' : layout.measure === 'wide' ? 'max-w-6xl' : 'max-w-4xl',
		]}
	>
		{
			hero.eyebrow && (
				<p
					class:list={[
						'op-eyebrow mb-6 inline-flex items-center border border-line px-3 py-1 text-xs tracking-widest uppercase',
						banner ? 'border-current' : 'text-muted',
					]}
				>
					{hero.eyebrow}
				</p>
			)
		}

		{
			split ? (
				<div class="grid gap-x-12 gap-y-8 lg:grid-cols-[1.15fr_1fr] lg:items-end">
					<h1 class="op-display text-5xl text-balance sm:text-6xl">{hero.title}</h1>
					<div>
						{hero.lead && (
							<p
								class="op-body text-lg leading-relaxed text-muted text-pretty"
								set:html={md(hero.lead)}
							/>
						)}
						{hero.ctas && hero.ctas.length > 0 && (
							<div class="mt-8 flex flex-wrap gap-3">
								{hero.ctas.map(cta => (
									<Button cta={cta} />
								))}
							</div>
						)}
					</div>
				</div>
			) : (
				<>
					<h1
						class:list={[
							'op-display text-balance',
							layout.hero === 'banner'
								? 'text-5xl sm:text-8xl'
								: 'text-5xl sm:text-7xl',
						]}
					>
						{hero.title}
					</h1>
					{hero.lead && (
						<p
							class:list={[
								'op-body mt-7 text-lg leading-relaxed text-pretty sm:text-xl',
								centred ? 'mx-auto max-w-2xl' : 'max-w-2xl',
								banner ? 'opacity-80' : 'text-muted',
							]}
							set:html={md(hero.lead)}
						/>
					)}
					{hero.ctas && hero.ctas.length > 0 && (
						<div
							class:list={[
								'mt-10 flex flex-wrap gap-3',
								centred && 'justify-center',
							]}
						>
							{hero.ctas.map(cta => (
								<Button cta={cta} />
							))}
						</div>
					)}
				</>
			)
		}
	</div>
</section>
