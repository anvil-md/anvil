---
import type { Page } from '@/types'

interface Props {
	brand?: string
	sections: Page['sections']
}

const { brand, sections } = Astro.props
const links = sections.filter(section => section.nav)
---

<header
	class="op-nav fixed inset-x-0 top-0 z-40 border-b border-line/60 bg-bg/70 backdrop-blur-xl backdrop-saturate-150"
>
	<nav class="op-measure mx-auto flex h-14 max-w-5xl items-center gap-6 px-6">
		<a href="#top" class="op-h2 text-sm whitespace-nowrap">{brand}</a>
		{
			links.length > 0 && (
				<ul class="ml-auto hidden items-center gap-1 sm:flex">
					{links.map(section => (
						<li>
							<a
								href={`#${section.id}`}
								data-navlink={section.id}
								class="op-body px-3 py-1.5 text-sm text-muted transition-colors hover:text-fg data-[active=true]:text-accent"
							>
								{section.nav}
							</a>
						</li>
					))}
				</ul>
			)
		}
	</nav>
</header>
