---
import { md } from '@/lib/md'

interface Props {
	id: string
	title?: string
	lead?: string
	/** 'prose' narrows the column for long-form reading. */
	width?: 'prose' | 'wide'
	class?: string
}

const { id, title, lead, width = 'wide', class: extra } = Astro.props
---

<section id={id} class:list={['op-section scroll-mt-20 px-6 py-24 sm:py-32', extra]}>
	<div
		class:list={[
			'op-measure mx-auto w-full',
			width === 'prose' ? 'max-w-2xl' : 'max-w-5xl',
		]}
	>
		{
			(title || lead) && (
				<header class="mb-14 max-w-2xl">
					{title && <h2 class="op-h2 text-3xl text-balance sm:text-4xl">{title}</h2>}
					{lead && (
						<p
							class="op-body mt-4 text-lg leading-relaxed text-muted text-pretty"
							set:html={md(lead)}
						/>
					)}
				</header>
			)
		}
		<slot />
	</div>
</section>
