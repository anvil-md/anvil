---
import { md } from '@/lib/md'
import type { Page } from '@/types'

interface Props {
	footer?: Page['footer']
}

const { footer } = Astro.props
const year = new Date().getFullYear()
---

<footer class="border-t border-line/70 px-6 py-12">
	<div
		class="mx-auto flex max-w-5xl flex-col gap-4 text-sm text-muted sm:flex-row sm:items-center sm:justify-between"
	>
		<p set:html={md(footer?.text ?? `&copy; ${year}`)} />
		{
			footer?.links && footer.links.length > 0 && (
				<ul class="flex flex-wrap gap-5">
					{footer.links.map(link => (
						<li>
							<a
								href={link.href}
								class="transition-colors hover:text-fg"
								target={/^https?:\/\//.test(link.href) ? '_blank' : undefined}
								rel={/^https?:\/\//.test(link.href) ? 'noopener noreferrer' : undefined}
							>
								{link.label}
							</a>
						</li>
					))}
				</ul>
			)
		}
	</div>
</footer>
