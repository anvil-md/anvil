---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { page } from '@/page'

const notFound = { ...page, meta: { ...page.meta, title: `Not found — ${page.meta.title}` } }
---

<BaseLayout page={notFound}>
	<main class="flex min-h-screen flex-col items-center justify-center gap-6 px-6 text-center">
		<p class="font-mono text-sm tracking-widest text-accent uppercase">404</p>
		<h1 class="font-display text-4xl font-semibold tracking-tight">Nothing here</h1>
		<a
			href="/"
			class="rounded-full bg-accent px-6 py-3 text-sm font-medium text-accent-fg transition-all hover:brightness-110"
		>
			Back to the start
		</a>
	</main>
</BaseLayout>
