{
  "name": "@anvil-md/parser",
  "version": "0.5.1",
  "description": "Parser for ANVIL, a tiny DSL that turns a fenced code block into an interactive UI block. Zero dependencies, total by contract.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anvil-md/anvil.git",
    "directory": "packages/parser"
  },
  "homepage": "https://anvil-md.frst.dev",
  "bugs": "https://github.com/anvil-md/anvil/issues",
  "keywords": [
    "anvil",
    "dsl",
    "parser",
    "markdown",
    "llm",
    "agent",
    "chat",
    "ui"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "bun test",
    "prepack": "bun ../../scripts/build-packages.ts parser"
  },
  "publishConfig": {
    "access": "public"
  }
}
