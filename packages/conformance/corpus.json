{
  "version": 1,
  "about": "The ANVIL conformance corpus. Every case is a source string plus what any conformant implementation must make of it. Language-agnostic on purpose: read this file, run your parser, compare. See README.md for the schema and §14 of SPEC.md for what conformance means.",
  "cases": [
    {
      "id": "choice-basic",
      "spec": "4.1",
      "title": "a choice keeps its rows in order, with hints",
      "source": "@choice id=deploy\n? Where?\n: Staging is wiped nightly.\n- prod  | Production | live traffic\n- stage | Staging",
      "expect": {
        "blocks": [
          {
            "kind": "choice",
            "id": "deploy",
            "derivedId": false,
            "prompt": "Where?",
            "subtext": "Staging is wiped nightly.",
            "optionValues": ["prod", "stage"]
          }
        ],
        "warnings": []
      }
    },
    {
      "id": "choice-danger-row",
      "spec": "4.1",
      "title": "a ! prefix marks one row destructive without touching the value",
      "source": "@choice id=c\n? Q\n- !wipe | Start over",
      "expect": { "blocks": [{ "kind": "choice", "optionValues": ["wipe"] }], "warnings": [] }
    },
    {
      "id": "derived-id-is-content-not-position",
      "spec": "11",
      "title": "two identical blocks in different positions derive the same id",
      "source": "@note\n> filler\n\n@choice\n? Q\n- a | A",
      "expect": { "blocks": [{ "kind": "note" }, { "kind": "choice", "derivedId": true }] },
      "sameDerivedIdAs": "@choice\n? Q\n- a | A"
    },
    {
      "id": "unknown-kind-warns-and-renders",
      "spec": "11",
      "title": "an unknown block becomes a warned note rather than nothing",
      "source": "@wormhole id=x\n? hi",
      "expect": {
        "blocks": [{ "kind": "note" }],
        "warningsContain": ["unknown block"]
      }
    },
    {
      "id": "unknown-field-type-falls-back",
      "spec": "4.3",
      "title": "an unknown field type becomes text and says so",
      "source": "@input id=i\n_ email | emial | Email",
      "expect": { "blocks": [{ "kind": "input" }], "warningsContain": ["unknown field type"] }
    },
    {
      "id": "secret-never-renders-in-the-clear",
      "spec": "4.3",
      "title": "a secret field is masked by the control, not by the value",
      "source": "@input id=i\n_ token | secret | API key",
      "expect": { "htmlContains": ["type=\"password\""] }
    },

    {
      "id": "card-progress-is-counted",
      "spec": "4.12.1",
      "title": "the bar is counted from the rows and no attribute can move it",
      "source": "@card id=c progress=99 done=9 total=9\n? T\n- [x] a\n- [ ] b\n- [ ] c",
      "expect": {
        "blocks": [{ "kind": "card", "taskStates": ["done", "todo", "todo"], "progress": { "done": 1, "total": 3, "pct": 33 } }],
        "htmlContains": ["1/3 · 33%"],
        "htmlExcludes": ["9/9"]
      }
    },
    {
      "id": "card-checkbox-states",
      "spec": "4.12",
      "title": "four states, plus the two in-flight aliases",
      "source": "@card id=c\n- [ ] a\n- [x] b\n- [~] c\n- [!] d\n- [/] e\n- [-] f",
      "expect": {
        "blocks": [{ "taskStates": ["todo", "done", "flight", "blocked", "flight", "flight"] }],
        "warnings": []
      }
    },
    {
      "id": "card-ref-doubles-as-label",
      "spec": "4.12",
      "title": "one cell means the ref is the label, exactly as an option value is",
      "source": "@card id=c\n- [ ] Write the runbook",
      "expect": { "blocks": [{ "taskRefs": ["Write the runbook"], "taskLabels": ["Write the runbook"] }] }
    },
    {
      "id": "card-epic-rollup",
      "spec": "4.12.1",
      "title": "a parent sums the n/m its children carry",
      "source": "@card id=e type=epic\n- [~] A | Story A | 3/7\n- [x] B | Story B | 6/6\n- [ ] C | Story C | 0/9",
      "expect": {
        "blocks": [{ "progress": { "done": 9, "total": 22, "pct": 41, "rollup": true } }],
        "htmlContains": ["9/22"]
      }
    },
    {
      "id": "card-rollup-mixed-with-bare-rows",
      "spec": "4.12.1",
      "title": "a bare row counts as one of one once any row rolls up",
      "source": "@card id=e\n- [~] A | Story A | 3/7\n- [x] B | Story B",
      "expect": { "blocks": [{ "progress": { "done": 4, "total": 8, "rollup": true } }] }
    },
    {
      "id": "card-rollup-needs-a-separator",
      "spec": "4.12.1",
      "title": "a date in the meta cell is not a count",
      "source": "@card id=c\n- [ ] ANV-1 | Ship it | due 24/12",
      "expect": {
        "blocks": [{ "progress": { "done": 0, "total": 1 }, "taskRollups": [null] }],
        "warningsContain": ["not a rollup"]
      }
    },
    {
      "id": "card-rollup-after-separator",
      "spec": "4.12.1",
      "title": "a count after an explicit separator rolls up and keeps the rest of the cell",
      "source": "@card id=c\n- [~] A | Story | Kit · 6/6",
      "expect": { "blocks": [{ "taskMeta": ["Kit"], "progress": { "done": 6, "total": 6 } }], "warnings": [] }
    },
    {
      "id": "card-rollup-refuses-impossible-counts",
      "spec": "4.12.1",
      "title": "more done than total is refused, not clamped into a confident lie",
      "source": "@card id=c\n- [~] A | Story | 9/4",
      "expect": { "blocks": [{ "taskRollups": [null] }], "warningsContain": ["more done than total"] }
    },
    {
      "id": "card-status-loses-to-the-rows",
      "spec": "4.12.1",
      "title": "an authored status that contradicts the count loses and warns",
      "source": "@card id=c status=done\n- [ ] a\n- [ ] b",
      "expect": { "warningsContain": ["contradicts 0/2"], "htmlContains": ["data-state=\"todo\""] }
    },
    {
      "id": "card-status-blocked-is-never-a-contradiction",
      "spec": "4.12.1",
      "title": "blocked is a fact about the world the rows cannot check",
      "source": "@card id=c status=blocked\n- [ ] a",
      "expect": { "warnings": [], "htmlContains": ["data-state=\"blocked\""] }
    },
    {
      "id": "card-detail-is-reachable-without-a-pointer",
      "spec": "4.12.3",
      "title": "row detail is in the document and described from its row",
      "source": "@card id=c\n- [~] A | Story\n> Needs the SQS policy.",
      "expect": {
        "blocks": [{ "taskDetails": ["Needs the SQS policy."] }],
        "htmlContains": ["aria-describedby=", "tabindex=\"0\"", "Needs the SQS policy."]
      }
    },
    {
      "id": "card-prose-before-rows-is-the-cards-own",
      "spec": "4.12.3",
      "title": "prose written before the first row belongs to the card and is drawn",
      "source": "@card id=c\n> Blocked on legal review.\n- [ ] a",
      "expect": { "htmlContains": ["Blocked on legal review."] }
    },
    {
      "id": "card-is-a-record-until-ask",
      "spec": "4.12.4",
      "title": "no ask, no affordance",
      "source": "@card id=c\n- [ ] a\n- [ ] b",
      "expect": { "htmlExcludes": ["anvil-submit", "anvil-task-pick\""] }
    },
    {
      "id": "card-ask-offers-only-open-rows",
      "spec": "4.12.4",
      "title": "a done or blocked subtask is not an offer",
      "source": "@card id=c ask=\"What next?\"\n- [x] a\n- [!] b\n- [ ] c\n- [ ] d",
      "expect": { "htmlContains": ["What next?"], "htmlCount": { "anvil-task-pick\"": 2 } }
    },
    {
      "id": "card-checkbox-on-a-choice-warns",
      "spec": "4.12",
      "title": "a task row in the wrong block still renders, with a complaint",
      "source": "@choice id=c\n- [x] a | A",
      "expect": { "blocks": [{ "kind": "choice", "optionValues": ["a"] }], "warningsContain": ["only @card and @board"] }
    },
    {
      "id": "card-href-is-allowlisted",
      "spec": "4.12",
      "title": "the one outbound affordance is http(s) only",
      "source": "@card id=ANV-1 href=javascript:alert(1)\n- [ ] a",
      "expect": { "htmlExcludes": ["javascript:", "<a "] }
    },

    {
      "id": "board-lanes-are-derived",
      "spec": "4.13",
      "title": "an empty lane does not render and a full one counts itself",
      "source": "@board id=b\n? S\n- [ ] a\n- [ ] b\n- [x] c",
      "expect": {
        "htmlContains": ["data-state=\"todo\"", "data-state=\"done\"", "1/3 · 33% done"],
        "htmlExcludes": ["data-state=\"blocked\""]
      }
    },
    {
      "id": "board-truncation-is-never-silent",
      "spec": "4.13",
      "title": "max bounds a lane and the board says how much it hid",
      "source": "@board id=b max=1\n? S\n- [ ] a\n- [ ] b\n- [ ] c",
      "expect": { "htmlContains": ["+2 more"] }
    },
    {
      "id": "board-lane-bar-is-a-share-not-progress",
      "spec": "4.13",
      "title": "three todo cards are not three done",
      "source": "@board id=b\n? S\n- [ ] a\n- [ ] b\n- [x] c",
      "expect": { "htmlContains": ["2 of 3 cards todo"], "htmlExcludes": ["2 of 3 done"] }
    },
    {
      "id": "board-never-submits",
      "spec": "4.13",
      "title": "a board is a record of many things and holds no single question",
      "source": "@board id=b ask=\"which?\" select=many\n- [ ] a",
      "expect": { "htmlExcludes": ["anvil-submit"] }
    },

    {
      "id": "message-is-a-draft-by-default",
      "spec": "4.15.1",
      "title": "sent must be asserted",
      "source": "@message channel=email to=\"a@x\"\n? S\n> body",
      "expect": { "htmlContains": ["data-state=\"draft\"", "data-locked=\"no\"", "not sent"] }
    },
    {
      "id": "message-every-spelling-of-no",
      "spec": "4.15.1",
      "title": "a capital letter must not defeat the safety default",
      "source": "@message to=\"a@x\" sent=No\n> body",
      "expect": { "htmlContains": ["data-state=\"draft\""] }
    },
    {
      "id": "message-sent-is-visibly-different",
      "spec": "4.15.1",
      "title": "an asserted send reads as sent, with its time",
      "source": "@message channel=whatsapp to=\"+66900\" sent=14:07\n> shipped",
      "expect": { "htmlContains": ["data-state=\"sent\"", "at 14:07"], "htmlExcludes": ["not sent"] }
    },
    {
      "id": "message-approved-is-not-sent",
      "spec": "4.15.5",
      "title": "the click is approval; delivery is a later fact from a different actor",
      "source": "@message to=\"a@x\" ask=\"Send?\" state=approved at=14:04\n> body",
      "expect": {
        "htmlContains": ["data-state=\"approved\"", "data-locked=\"yes\"", "sending"],
        "htmlExcludes": [">sent<", "anvil-submit"]
      }
    },
    {
      "id": "message-gate-becomes-a-receipt",
      "spec": "4.15.5",
      "title": "the gate transforms rather than vanishing, so the height holds",
      "source": "@message to=\"a@x\" ask=\"Send it?\" state=sent at=14:07 by=Ana\n> body",
      "expect": {
        "htmlContains": ["anvil-msg-gate", "anvil-msg-receipt", "Send it?", "by Ana · at 14:07"],
        "htmlExcludes": ["anvil-submit"]
      }
    },
    {
      "id": "message-failure-says-why",
      "spec": "4.15.5",
      "title": "a send that failed is not a draft and not a send",
      "source": "@message to=\"a@x\" ask=\"Send?\" error=\"550 mailbox unavailable\"\n> body",
      "expect": { "htmlContains": ["data-state=\"failed\"", "550 mailbox unavailable"] }
    },
    {
      "id": "message-declined-keeps-the-record",
      "spec": "4.15.5",
      "title": "a declined message stays legible and stops pretending it is going anywhere",
      "source": "@message to=\"a@x\" ask=\"Send?\" state=declined by=Ana\n> body",
      "expect": { "htmlContains": ["data-state=\"declined\"", "body", "Send?"], "htmlExcludes": ["anvil-submit"] }
    },
    {
      "id": "message-addresses-are-not-links",
      "spec": "4.15.2",
      "title": "nothing in a draft is one mis-click from a composer",
      "source": "@message channel=email to=\"a@x\" cc=\"b@x; c@x\"\n? S\n> body",
      "expect": { "htmlContains": ["a@x", "b@x", "c@x"], "htmlExcludes": ["mailto:", "<a "] }
    },
    {
      "id": "message-subject-alias",
      "spec": "4.15",
      "title": "subject= fills the title and the ? line wins over it",
      "source": "@message to=\"a@x\" subject=\"From attr\"\n? From the line\n> body",
      "expect": { "blocks": [{ "prompt": "From the line" }], "htmlExcludes": ["From attr"] }
    },
    {
      "id": "message-unknown-channel-borrows-nothing",
      "spec": "4.15.4",
      "title": "an unrecognised channel is a memo, not somebody else's bubble",
      "source": "@message channel=carrierpigeon to=\"a@x\"\n> body",
      "expect": { "htmlContains": ["anvil-msg-envelope", "unknown channel"], "htmlExcludes": ["anvil-msg-bubble"] }
    },
    {
      "id": "message-attachment-is-one-line",
      "spec": "4.15",
      "title": "name and size are one attachment, not two",
      "source": "@message to=\"a@x\"\n> body\n+ patch.diff | 4 KB",
      "expect": { "blocks": [{ "meta": [["patch.diff", "4 KB"]] }], "htmlCount": { "<li>": 1 } }
    },
    {
      "id": "message-button-says-what-it-does",
      "spec": "4.15.2",
      "title": "Send, not Confirm",
      "source": "@message to=\"a@x\" ask=\"Send it?\"\n> body",
      "expect": { "htmlContains": [">Send<"] }
    },

    {
      "id": "layout-holds-children",
      "spec": "4.14",
      "title": "a container nests rather than flattening into the document",
      "source": "@grid cols=3\n@card id=a\n? A\n@card id=b\n? B\n@end",
      "expect": {
        "topLevelKinds": ["grid"],
        "tree": [{ "kind": "grid", "children": ["a", "b"] }]
      }
    },
    {
      "id": "layout-has-no-identity",
      "spec": "4.14",
      "title": "an id on a container is refused, because layout cannot be answered",
      "source": "@grid id=nope\n@card id=a\n? A",
      "expect": { "blocks": [{ "kind": "grid", "id": "" }], "warningsContain": ["layout has no id"] }
    },
    {
      "id": "layout-unclosed-closes-at-the-fence",
      "spec": "4.14",
      "title": "a truncated grid renders what arrived",
      "source": "@grid cols=2\n@card id=a\n? A",
      "partial": true,
      "expect": { "topLevelKinds": ["grid"], "tree": [{ "kind": "grid", "children": ["a"] }] }
    },
    {
      "id": "layout-depth-is-capped-and-stays-balanced",
      "spec": "4.14",
      "title": "a third level flattens, warns once, and still eats its @end",
      "source": "@grid\n@stack\n@grid\n@card id=deep\n? D\n@end\n@end\n@card id=after\n? A",
      "expect": {
        "topLevelKinds": ["grid"],
        "maxDepth": 2,
        "warningsContain": ["flattened"]
      }
    },
    {
      "id": "layout-rows-are-not-silently-eaten",
      "spec": "4.14",
      "title": "a container holds blocks; anything else says so",
      "source": "@grid\n- opt | O\n+ chip\n@end",
      "expect": { "warningsContain": ["holds blocks"] }
    },
    {
      "id": "layout-stray-end",
      "spec": "4.14",
      "title": "an @end with nothing open is visible, not silent",
      "source": "@end",
      "expect": { "warningsContain": ["stray @end"] }
    },
    {
      "id": "layout-emits-no-breakpoint",
      "spec": "4.14",
      "title": "cols is a maximum, clamped, and gap is a keyword",
      "source": "@grid cols=99 gap=8rem min=100vw\n@note\n> x",
      "expect": {
        "htmlContains": ["--anvil-cols:6", "--anvil-lgap:0.6rem"],
        "htmlExcludes": ["--anvil-min", "100vw"]
      }
    },

    {
      "id": "injection-swatch",
      "spec": "8.3",
      "title": "a non-hex swatch is dropped rather than escaped into a style attribute",
      "source": "@gallery id=g render=swatch\n- a | A | swatch=#fff;}</style><script>alert(1)</script>",
      "expect": { "htmlExcludes": ["<script", "</style>"] }
    },
    {
      "id": "injection-img",
      "spec": "8.3",
      "title": "a non-http img never reaches src",
      "source": "@gallery id=g\n- a | A | img=javascript:alert(1)",
      "expect": { "htmlExcludes": ["javascript:"] }
    },
    {
      "id": "injection-prototype-key",
      "spec": "8.3",
      "title": "an inherited property is not a valid keyword",
      "source": "@grid gap=constructor\n@note tone=toString\n> x",
      "expect": { "htmlContains": ["--anvil-lgap:0.6rem"], "htmlExcludes": ["native code"] }
    },
    {
      "id": "injection-prompt-escaped",
      "spec": "8.3",
      "title": "prompt text is escaped",
      "source": "@choice id=c\n? <script>alert(1)</script>\n- a | A",
      "expect": { "htmlExcludes": ["<script>"] }
    },

    {
      "id": "scale-knob-stays-on-its-track",
      "spec": "4.8",
      "title": "an out-of-range steps= resolves once, in the parser",
      "source": "@scale id=s steps=1\n% a | Lo | Hi | 4",
      "expect": { "warningsContain": ["out of range"], "htmlExcludes": ["left:300.0%"] }
    },
    {
      "id": "note-carries-its-warnings-inside",
      "spec": "4.5",
      "title": "a note has no frame to hang a warning off, so it holds its own",
      "source": "@nonsense\n? hi",
      "expect": { "htmlContains": ["anvil-warn"] }
    },
    {
      "id": "comment-never-reaches-the-document",
      "spec": "3.1",
      "title": "a hash line is parsed and dropped",
      "source": "# not content\n@choice id=c\n? Q\n- a | A",
      "expect": { "blocks": [{ "kind": "choice", "prompt": "Q" }], "htmlExcludes": ["not content"] }
    },
    {
      "id": "escaped-pipe-in-a-label",
      "spec": "3.2",
      "title": "a literal pipe survives the cell split",
      "source": "@choice id=c\n? Q\n- a | A \\| B",
      "expect": { "blocks": [{ "optionLabels": ["A | B"] }] }
    },
    {
      "id": "streaming-is-inert",
      "spec": "5",
      "title": "an unfinished fence renders, visibly provisional",
      "source": "@choice id=c\n? Q\n- a | A",
      "partial": true,
      "expect": { "htmlContains": ["anvil-doc-streaming"] }
    },
    {
      "id": "empty-source",
      "spec": "11",
      "title": "nothing in, nothing out, no throw",
      "source": "",
      "expect": { "topLevelKinds": [] }
    },
    {
      "id": "degenerate-sigils",
      "spec": "11",
      "title": "every sigil with no payload survives",
      "source": "@\n- \n_ \n% \n+ \n? \n> \n@end\n~~~",
      "expect": { "neverThrows": true }
    },
    {
      "id": "chart-basic",
      "spec": "4.16",
      "title": "a chart row is label, number, note, and the number is printed",
      "source": "@chart id=signups render=bar unit=k\n? Signups by week\n- W21 | 3.2\n- W22 | 4.8 | launch\n- W23 | 4.1",
      "expect": {
        "blocks": [
          {
            "kind": "chart",
            "id": "signups",
            "prompt": "Signups by week",
            "dataLabels": ["W21", "W22", "W23"],
            "dataValues": [3.2, 4.8, 4.1]
          }
        ],
        "warnings": [],
        "htmlContains": ["3.2k", "4.8k", "4.1k", "launch"]
      }
    },
    {
      "id": "chart-raw-value-is-not-rewritten",
      "spec": "4.16.1",
      "title": "4.8k is drawn as 4800 and printed as 4.8k",
      "source": "@chart id=c\n? Q\n- a | 4.8k\n- b | 1,204",
      "expect": {
        "blocks": [{ "dataValues": [4800, 1204], "dataRaw": ["4.8k", "1,204"] }],
        "htmlContains": ["4.8k", "1,204"],
        "htmlExcludes": ["4800"]
      }
    },
    {
      "id": "chart-non-number-is-refused",
      "spec": "4.16.2",
      "title": "a value cell with no number is warned about and not drawn at zero",
      "source": "@chart id=c\n? Q\n- Mon | lots\n- Tue | 4",
      "expect": {
        "blocks": [{ "dataLabels": ["Tue"] }],
        "warningsContain": ["has no number in its value cell"]
      }
    },
    {
      "id": "chart-floor-is-zero",
      "spec": "4.16.2",
      "title": "the range starts at zero, so a bar length is a magnitude",
      "source": "@chart id=c\n? Q\n- a | 96\n- b | 98",
      "expect": { "blocks": [{ "domain": { "floor": 0, "top": 98 } }] }
    },
    {
      "id": "chart-negative-lowers-the-floor",
      "spec": "4.16.2",
      "title": "negative data widens the range downwards and puts zero inside it",
      "source": "@chart id=c\n? Q\n- a | -4\n- b | 8",
      "expect": { "blocks": [{ "domain": { "floor": -4, "top": 8 } }] }
    },
    {
      "id": "chart-max-below-data-warns",
      "spec": "4.16.2",
      "title": "max= under the largest value is a warning, and nothing is clipped",
      "source": "@chart id=c max=50\n? Q\n- a | 90",
      "expect": {
        "blocks": [{ "domain": { "top": 90, "authoredTop": false } }],
        "warningsContain": ["below the largest value (90)"]
      }
    },
    {
      "id": "chart-truncated-axis-is-announced",
      "spec": "4.16.2",
      "title": "min= may lift the floor, and the block must say that it did",
      "source": "@chart id=c unit=% min=99 max=100\n? Q\n- a | 99.21\n- b | 99.99",
      "expect": {
        "blocks": [{ "domain": { "floor": 99, "top": 100, "authoredFloor": true } }],
        "warnings": [],
        "htmlContains": ["not zero"]
      }
    },
    {
      "id": "chart-min-cannot-exclude-data",
      "spec": "4.16.2",
      "title": "a floor above the smallest value would clip it, so the value wins",
      "source": "@chart id=c min=99.5\n? Q\n- a | 99.21\n- b | 99.99",
      "expect": {
        "blocks": [{ "domain": { "floor": 99.21 } }],
        "warningsContain": ["is above the smallest value (99.21)"]
      }
    },
    {
      "id": "chart-max-above-data-widens",
      "spec": "4.16.2",
      "title": "max= above the largest value is context and is kept",
      "source": "@chart id=c max=100\n? Q\n- a | 40",
      "expect": { "blocks": [{ "domain": { "top": 100, "authoredTop": true } }], "warnings": [] }
    },
    {
      "id": "chart-values-attribute-is-sugar",
      "spec": "4.16.4",
      "title": "values= builds an unlabelled series, and rows win when both are given",
      "source": "@chart id=c render=spark values=3,5,4\n? Q",
      "expect": { "blocks": [{ "dataValues": [3, 5, 4], "dataLabels": ["", "", ""] }], "warnings": [] }
    },
    {
      "id": "chart-rows-beat-values",
      "spec": "4.16.4",
      "title": "a block with both keeps the rows and says the attribute was dropped",
      "source": "@chart id=c values=3,5,4\n? Q\n- a | 9",
      "expect": {
        "blocks": [{ "dataValues": [9] }],
        "warningsContain": ["values= is ignored"]
      }
    },
    {
      "id": "chart-series-is-readable-without-the-picture",
      "spec": "4.16.1",
      "title": "a line carries every value in text, because the shape is aria-hidden",
      "source": "@chart id=c render=line unit=ms values=1,2,3\n? Q",
      "expect": { "htmlContains": ["Point 1: 1 ms", "Point 3: 3 ms"] }
    },
    {
      "id": "flow-arrow-decides-the-row",
      "spec": "4.17",
      "title": "a row with an arrow is an edge; a row without declares a node",
      "source": "@flow id=f\n? Q\n- [x] charge | Charge\n- [~] retry | Retry\n- charge -> retry | fails",
      "expect": {
        "blocks": [
          {
            "kind": "flow",
            "nodeIds": ["charge", "retry"],
            "nodeStates": ["done", "flight"],
            "edges": ["charge>retry"]
          }
        ],
        "warnings": [],
        "htmlContains": ["fails"]
      }
    },
    {
      "id": "flow-implied-node",
      "spec": "4.17.2",
      "title": "an edge may name a node nobody declared",
      "source": "@flow id=f\n? Q\n- build -> test",
      "expect": { "blocks": [{ "nodeIds": ["build", "test"], "ranks": [["build"], ["test"]] }], "warnings": [] }
    },
    {
      "id": "flow-chain-is-one-row",
      "spec": "4.17",
      "title": "a -> b -> c is one row and two edges",
      "source": "@flow id=f\n? Q\n- a -> b -> c",
      "expect": { "blocks": [{ "edges": ["a>b", "b>c"] }], "warnings": [] }
    },
    {
      "id": "flow-undirected-needs-spaces",
      "spec": "4.17",
      "title": "dead-letter is an id; a -- b is a connection",
      "source": "@flow id=f\n? Q\n- dead-letter -> sink\n- sink -- audit",
      "expect": { "blocks": [{ "edges": ["dead-letter>sink", "sink>audit"] }], "warnings": [] }
    },
    {
      "id": "flow-longest-path-layering",
      "spec": "4.17.3",
      "title": "a step waiting on two things is drawn after both of them",
      "source": "@flow id=f\n? Q\n- a -> b\n- b -> c\n- a -> c",
      "expect": { "blocks": [{ "ranks": [["a"], ["b"], ["c"]] }] }
    },
    {
      "id": "flow-cycle-terminates",
      "spec": "4.17.3",
      "title": "a cycle ranks the forward edges and keeps the back edge as a return",
      "source": "@flow id=f\n? Q\n- a -> b\n- b -> c\n- c -> a",
      "expect": {
        "blocks": [{ "ranks": [["a"], ["b"], ["c"]], "backEdges": ["c>a"] }],
        "htmlContains": ["anvil-flow-back"]
      }
    },
    {
      "id": "flow-self-loop-is-refused",
      "spec": "4.17.2",
      "title": "an arrow pointing at its own source is the typo it looks like",
      "source": "@flow id=f\n? Q\n- a -> a\n- a -> b",
      "expect": { "blocks": [{ "edges": ["a>b"] }], "warningsContain": ["points at itself"] }
    },
    {
      "id": "flow-truncation-is-counted",
      "spec": "4.17.4",
      "title": "nodes past the cap are counted rather than silently dropped",
      "source": "@flow id=f\n? Q\n- n0 -> n1 -> n2 -> n3 -> n4 -> n5 -> n6 -> n7 -> n8 -> n9 -> n10 -> n11 -> n12 -> n13 -> n14 -> n15 -> n16 -> n17 -> n18 -> n19 -> n20 -> n21 -> n22 -> n23 -> n24 -> n25 -> n26 -> n27 -> n28 -> n29 -> n30 -> n31 -> n32 -> n33 -> n34 -> n35 -> n36 -> n37 -> n38 -> n39 -> n40 -> n41 -> n42",
      "expect": {
        "warningsContain": ["is past the 40"],
        "htmlContains": ["+3 more"]
      }
    },
    {
      "id": "flow-diagram-has-a-reading-order",
      "spec": "4.17",
      "title": "the svg is accompanied by the same graph as text",
      "source": "@flow id=f\n? Q\n- [x] build | Build\n- build -> test",
      "expect": { "htmlContains": ["Step 1: Build", "build leads to test"] }
    },
    {
      "id": "recommend-marks-one-row-in-words",
      "spec": "4.1.1",
      "title": "recommend= marks the row it names, says so in words, and leaves the label alone",
      "source": "@choice id=plan recommend=pro\n? Which plan?\n- basic | Basic\n- pro   | Pro | adds the shared inbox",
      "expect": {
        "blocks": [{ "kind": "choice", "recommended": "pro", "optionLabels": ["Basic", "Pro"] }],
        "warnings": [],
        "htmlContains": ["recommended"]
      }
    },
    {
      "id": "recommend-naming-nothing-marks-nothing",
      "spec": "4.1.1",
      "title": "a recommendation that names no option is dropped whole, never matched to the nearest",
      "source": "@choice id=plan recommend=gold\n? Which plan?\n- basic | Basic\n- pro   | Pro",
      "expect": {
        "blocks": [{ "kind": "choice", "recommended": "" }],
        "warningsContain": ["recommend=\"gold\" names no option"]
      }
    },
    {
      "id": "recommend-on-a-card-must-be-an-open-row",
      "spec": "4.1.1",
      "title": "an asking card can only recommend a row the human can actually pick",
      "source": "@card id=c ask=\"What next?\" recommend=ANV-115\n- [x] ANV-115 | Retry scheduler\n- [ ] ANV-119 | Metrics",
      "expect": {
        "blocks": [{ "kind": "card", "recommended": "" }],
        "warningsContain": ["only open rows can be picked"]
      }
    },
    {
      "id": "recommend-needs-a-question",
      "spec": "4.1.1",
      "title": "a record card has nothing to recommend",
      "source": "@card id=c recommend=ANV-119\n- [ ] ANV-119 | Metrics",
      "expect": {
        "blocks": [{ "kind": "card", "recommended": "" }],
        "warningsContain": ["recommend= needs ask="]
      }
    },
    {
      "id": "chart-stat-change-is-computed",
      "spec": "4.16.5",
      "title": "a stat prints the change from was=, computed, beside the number it came from",
      "source": "@chart id=o render=stat better=up\n? Outreach today\n- Read   | 40 | was=32\n- Sent   | 9\n- Failed | 2  | was=0 | better=down",
      "expect": {
        "blocks": [
          {
            "kind": "chart",
            "dataRaw": ["40", "9", "2"],
            "dataDeltas": [
              { "diff": 8, "pct": 25, "tone": "good" },
              null,
              { "diff": 2, "pct": null, "tone": "bad" }
            ]
          }
        ],
        "warnings": [],
        "htmlContains": ["+8 · +25%", "from 32", "+2"]
      }
    },
    {
      "id": "chart-stat-verdict-is-never-guessed",
      "spec": "4.16.5",
      "title": "without better= a change has a direction and no verdict",
      "source": "@chart id=o render=stat\n- Leads | 12 | was=10",
      "expect": {
        "blocks": [{ "kind": "chart", "dataDeltas": [{ "diff": 2, "pct": 20, "tone": "neutral" }] }],
        "warnings": []
      }
    },
    {
      "id": "chart-stat-has-no-scale",
      "spec": "4.16.5",
      "title": "min=, max= and goal= move a range, and a stat has none, so they warn",
      "source": "@chart id=o render=stat goal=50 max=10\n- a | 40",
      "expect": {
        "blocks": [{ "kind": "chart", "dataValues": [40] }],
        "warningsContain": ["max=, goal= draw nothing on render=stat"]
      }
    },
    {
      "id": "chart-was-outside-stat-warns",
      "spec": "4.16.5",
      "title": "was= on a bar chart is parsed as a comparison, never as the note, and says it is not drawn",
      "source": "@chart id=o render=bar\n- a | 40 | was=32",
      "expect": {
        "blocks": [{ "kind": "chart", "dataRaw": ["40"] }],
        "warningsContain": ["only drawn by render=stat"],
        "htmlExcludes": ["was=32"]
      }
    },
    {
      "id": "chart-was-must-be-a-number",
      "spec": "4.16.5",
      "title": "an unreadable was= draws no change rather than a change from zero",
      "source": "@chart id=o render=stat\n- a | 40 | was=lots",
      "expect": {
        "blocks": [{ "kind": "chart", "dataDeltas": [null] }],
        "warningsContain": ["was=\"lots\" is not a number"]
      }
    }
  ]
}
