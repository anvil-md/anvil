{
  "name": "@anvil-md/conformance",
  "version": "0.5.0",
  "description": "The ANVIL conformance corpus: a language-level test suite any implementation can run, in any language. One JSON file of cases plus a runner for the reference implementation.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anvil-md/anvil.git",
    "directory": "packages/conformance"
  },
  "homepage": "https://anvil-md.frst.dev",
  "bugs": "https://github.com/anvil-md/anvil/issues",
  "keywords": [
    "anvil",
    "conformance",
    "test-suite",
    "dsl",
    "spec"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./corpus.json": "./corpus.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "corpus.json",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "bun test",
    "prepack": "bun ../../scripts/build-packages.ts conformance"
  },
  "publishConfig": {
    "access": "public"
  }
}
