{
  "name": "@anvil-md/react",
  "version": "0.5.1",
  "description": "ANVIL blocks as a React component, plus a react-markdown code renderer.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anvil-md/anvil.git",
    "directory": "packages/react"
  },
  "homepage": "https://anvil-md.frst.dev",
  "bugs": "https://github.com/anvil-md/anvil/issues",
  "keywords": [
    "anvil",
    "dsl",
    "markdown",
    "llm",
    "agent",
    "react",
    "react-markdown"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "README.md"
  ],
  "sideEffects": false,
  "dependencies": {
    "@anvil-md/render-html": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
