{
  "name": "@anvil-md/a2ui",
  "version": "0.5.0",
  "description": "Export ANVIL blocks to A2UI v1.0 surfaces, and turn A2UI actions back into frozen ANVIL stamps.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anvil-md/anvil.git",
    "directory": "packages/a2ui"
  },
  "homepage": "https://anvil-md.frst.dev",
  "keywords": [
    "anvil",
    "a2ui",
    "agent",
    "ui",
    "stamp"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "README.md"
  ],
  "dependencies": {
    "@anvil-md/parser": "workspace:*"
  },
  "scripts": {
    "test": "bun test",
    "prepack": "bun ../../scripts/build-packages.ts a2ui"
  },
  "devDependencies": {
    "ajv": "^8",
    "ajv-formats": "^3"
  },
  "publishConfig": {
    "access": "public"
  }
}
