{
  "name": "@anvil-md/lint",
  "version": "0.5.0",
  "description": "A validator for ANVIL source. Parse warnings plus the rules a total parser cannot enforce: colliding ids, authored progress, a form hiding in a grid, a message with nobody to send it to.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anvil-md/anvil.git",
    "directory": "packages/lint"
  },
  "homepage": "https://anvil-md.frst.dev",
  "bugs": "https://github.com/anvil-md/anvil/issues",
  "keywords": [
    "anvil",
    "lint",
    "validator",
    "dsl",
    "markdown",
    "agent"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "anvil-lint": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "README.md"
  ],
  "dependencies": {
    "@anvil-md/parser": "workspace:*"
  },
  "sideEffects": false,
  "scripts": {
    "test": "bun test",
    "prepack": "bun ../../scripts/build-packages.ts lint"
  },
  "publishConfig": {
    "access": "public"
  }
}
